{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "operate.to",
  "version": "0.1.0",
  "identifier": "to.operate.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "operate.to",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 480,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage", "deb"],
    "icon": ["icons/icon.png"]
  }
}
