# --- Convex ---
# From `npx convex dev` (writes to .env.local automatically) or the Convex dashboard.
NEXT_PUBLIC_CONVEX_URL=

# Used by Vercel build step to deploy Convex functions. Set in Vercel project settings only.
CONVEX_DEPLOY_KEY=

# --- Clerk ---
# https://dashboard.clerk.com -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# https://dashboard.clerk.com -> Webhooks (used to sync users into Convex).
# IMPORTANT: this value is consumed by Convex (not Next.js). Set it via:
#   npx convex env set CLERK_WEBHOOK_SECRET whsec_...
# Configure the webhook URL in Clerk to: https://<your-deployment>.convex.site/clerk
CLERK_WEBHOOK_SECRET=

# Clerk redirect URLs (kept in env so Vercel previews can override)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Clerk Frontend API URL — required by Convex's auth integration.
# Find it in Clerk dashboard -> API Keys -> "Frontend API".
NEXT_PUBLIC_CLERK_FRONTEND_API_URL=

# Public origin used for metadata, invite links, and OG URLs. Set this on
# Vercel to the canonical site (https://www.operate.to). Falls back to
# https://operate.to when unset.
NEXT_PUBLIC_APP_URL=

# --- Resend ---
# https://resend.com/api-keys
# Consumed by Convex (mention, assignment, invite, approval, due-soon
# emails). Unset = those actions log and no-op — set both in production.
RESEND_API_KEY=
# Verified sender, e.g. "operate.to <noreply@operate.to>"
RESEND_FROM_EMAIL=

# --- Platform administration (SOC2) ---
# Root of trust for the admin console. Comma-separated emails; anyone on
# this list is a superadmin and can grant scoped admin to others in-app.
# There is NO in-app path to become an admin without this list or an
# existing superadmin's grant. Consumed by Convex — set it via:
#   npx convex env set PLATFORM_ADMIN_EMAILS you@company.com,ops@company.com
PLATFORM_ADMIN_EMAILS=

# --- OpenAI (Convex only) ---
# Embeddings, Brain search, writer continue, task autofill, panel intent.
# Unset = those actions return a polite "AI is not configured".
#   npx convex env set OPENAI_API_KEY sk-...
OPENAI_API_KEY=

# --- Error tracking (optional) ---
# Sentry DSN. Unset is supported: errors stay on console. Set on Vercel
# (Next.js) and on Convex (Node actions) with the same project.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- x402 agent payments ---
# Agents top up a prepaid credit wallet by paying via the x402 protocol.
# PRODUCTION: leave metering OFF until X402_FACILITATOR_URL + X402_PAY_TO
# (a real receiving wallet, mainnet) are set. Never set X402_ALLOW_MOCK
# in production. Defaults below are testnet-only and fail-closed for
# settlement/metering until those two values exist.
# Set these on the CONVEX deployment (npx convex env set ...) —
# the settlement action reads them server-side; none are NEXT_PUBLIC.
#
# Payment facilitator that verifies + settles on-chain payments.
X402_FACILITATOR_URL=
# The built-in MOCK facilitator mints credits WITHOUT real settlement — dev
# and testing only. It is refused unless you explicitly opt in here, and
# metering cannot be enabled while neither a facilitator URL nor this flag is
# set (fail-closed, so production never hands out free credits). NEVER set
# this in production.
X402_ALLOW_MOCK=
# Network + asset agents pay in (defaults: Base Sepolia USDC).
X402_NETWORK=base-sepolia
X402_ASSET=0x036CbD53842c5426634e7929541eC2318f3dCF7e
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
# Receiving address credited on settlement. MUST be set for production.
X402_PAY_TO=
# Atomic asset units charged per 1 platform credit (default 1000 = $0.001
# per credit for 6-decimal USDC, i.e. 1000 credits = $1.00).
X402_CREDIT_PRICE_ATOMIC=1000
# Credits consumed per metered agent write action (default 1). Metering is
# OFF until a superadmin enables it in the admin console.
X402_ACTION_CREDITS=1

# Ably — the ephemeral half of realtime: typing indicators, presence, and
# nudges to clients that aren't holding a Convex subscription (agent runtimes,
# external listeners). Convex remains the source of truth for every message.
#
# Set it on CONVEX only: `npx convex env set ABLY_API_KEY ...`. Both halves of
# the stream go through convex/realtime.ts — it publishes with the key, and it
# mints the short-lived, subscribe-only, single-channel tokens the browser uses
# over Ably's SSE endpoint. The key itself never reaches a client, and no Ably
# SDK is bundled.
#
# Unset is a supported state: chat and every view still update live through
# Convex subscriptions. You lose typing indicators and out-of-app pushes, and
# the chat header reads "convex" instead of "live".
ABLY_API_KEY=

# Agent onboarding — the device flow behind `curl -fsSL /connect | sh`.
#
# OPERATE_PUBLIC_URL is the origin baked into the generated shell scripts
# (/connect, /install/skills) and the URLs they download skills from. It must
# be an HTTPS origin with no path, query or credentials — anything else is
# ignored in favour of the real site, because this value ends up inside a
# script people pipe into `sh`. Defaults to https://www.operate.to.
OPERATE_PUBLIC_URL=
#
# DEVICE_PROXY_SECRET hardens the rate limit on device-code creation. That
# mutation must be public and unauthenticated (the caller is a machine with no
# credential yet — the point of the grant), so anyone can call it directly and
# claim whatever client IP they like. Set the SAME value on Next and on Convex
# (`npx convex env set DEVICE_PROXY_SECRET ...`) and the per-IP budget is only
# extended to callers that prove they came through our own route; everyone
# else shares one small bucket.
#
# Unset is supported and is the default: the client IP is trusted as before.
# What is at stake is storage growth from request flooding, not an
# authorization boundary — no credential is issued without a human approving
# it either way. Set it in production.
DEVICE_PROXY_SECRET=
